digraph FlashShoesFX_UML {
    graph [rankdir=TB, splines=polyline, nodesep=0.65, ranksep=0.9, fontname="Helvetica", bgcolor="white"];
    node [shape=record, fontname="Helvetica", fontsize=10, style="filled", fillcolor="#F7F9FC", color="#2C3E50"];
    edge [fontname="Helvetica", fontsize=9, color="#2C3E50"];

    /* ===================== MODEL LAYER ===================== */

    User [label="{\<\<abstract\>\>\nUser|- userId : String\l- name : String\l- email : String\l- passwordHash : String\l|+ login(pw : String) : boolean\l+ logout() : void\l+ getRole() : String\l# hash(plain : String) : String\l}", fillcolor="#EAF1FB"];

    Customer [label="{Customer|- cart : Cart\l- orderHistory : List\<Order\>\l- walletBalance : double\l|+ getRole() : String\l+ addToCart(p : Product, qty : int) : void\l+ addOrderToHistory(o : Order) : void\l+ deductWallet(amount : double) : void\l}", fillcolor="#EAF1FB"];

    Admin [label="{Admin|- permissions : List\<String\>\l|+ getRole() : String\l+ hasPermission(p : String) : boolean\l}", fillcolor="#EAF1FB"];

    Product [label="{Product|- productId : String\l- name, brand, category, gender : String\l- price : double\l- stockQuantity : int\l- imagePath : String\l|+ updateStock(delta : int) : void\l+ getStockQuantity() : int\l}", fillcolor="#EAF1FB"];

    FlashSale [label="{FlashSale|- saleId : String\l- product : Product\l- discountPercent : double\l- startTime, endTime : LocalDateTime\l- limitedStock : AtomicInteger\l- status : SaleStatus\l|+ isActive() : boolean\l+ refreshStatus() : void\l+ getDiscountedPrice() : double\l}", fillcolor="#EAF1FB"];

    Cart [label="{Cart|- customer : Customer\l- items : Map\<Product,Integer\>\l|+ addItem(p : Product, qty : int) : void\l+ removeItem(p : Product) : void\l+ getTotal() : double\l}", fillcolor="#EAF1FB"];

    Order [label="{Order|- orderId : String\l- customer : Customer\l- items : List\<OrderItem\>\l- totalAmount : double\l- status : OrderStatus\l- paymentMethodUsed : String\l|+ calculateTotal() : double\l+ updateStatus(s : OrderStatus) : void\l}", fillcolor="#EAF1FB"];

    OrderItem [label="{OrderItem|- product : Product\l- quantity : int\l- priceAtPurchase : double\l|+ getLineTotal() : double\l}", fillcolor="#EAF1FB"];

    PaymentMethod [label="{\<\<interface\>\>\nPaymentMethod|- - -|+ processPayment(amount : double) : boolean\l+ getMethodName() : String\l}", fillcolor="#FDF3E7"];

    CashOnDelivery [label="{CashOnDelivery|- - -|+ processPayment(amount : double) : boolean\l+ getMethodName() : String\l}", fillcolor="#FDF3E7"];
    CreditCardPayment [label="{CreditCardPayment|- cardNumberMasked : String\l|+ processPayment(amount : double) : boolean\l+ getMethodName() : String\l}", fillcolor="#FDF3E7"];
    WalletPayment [label="{WalletPayment|- customer : Customer\l|+ processPayment(amount : double) : boolean\l+ getMethodName() : String\l}", fillcolor="#FDF3E7"];

    SaleStatus [label="{\<\<enum\>\>\nSaleStatus|UPCOMING\lACTIVE\lENDED\l}", fillcolor="#F1F1F1"];
    OrderStatus [label="{\<\<enum\>\>\nOrderStatus|PENDING\lCONFIRMED\lFAILED\lCANCELLED\l}", fillcolor="#F1F1F1"];

    /* ===================== SERVICE LAYER ===================== */

    InventoryManager [label="{InventoryManager|- stockLocks : ConcurrentHashMap\<String,Lock\>\l|+ reserveStock(p : Product, qty : int) : boolean\l+ reserveFlashSaleStock(s : FlashSale, qty : int) : boolean\l+ releaseStock(p : Product, qty : int) : void\l}", fillcolor="#EAF7EE"];

    FlashSaleScheduler [label="{FlashSaleScheduler|- flashSales : List\<FlashSale\>\l- executor : ScheduledExecutorService\l|+ start() : void\l+ stop() : void\l- tick() : void\l}", fillcolor="#EAF7EE"];

    OrderProcessor [label="{OrderProcessor\n\<\<implements Runnable\>\>|- orderQueue : BlockingQueue\<Order\>\l- running : boolean\l|+ submit(o : Order) : void\l+ start() : void\l+ run() : void\l}", fillcolor="#EAF7EE"];

    FileManager [label="{FileManager|- dataDir : String\l|+ loadProducts() : List\<Product\>\l+ saveProducts(...) : void\l+ loadUsers() / saveUsers()\l+ loadOrders() / saveOrders()\l+ loadFlashSales() / saveFlashSales()\l}", fillcolor="#EAF7EE"];

    DataStore [label="{\<\<singleton\>\>\nDataStore|- instance : DataStore\l- productsById : Map\l- usersById : Map\l- flashSales : List\l- orders : List\l- currentUser : User\l|+ getInstance() : DataStore\l+ addOrder(o : Order) : void\l+ getActiveFlashSales() : List\l}", fillcolor="#EAF7EE"];

    /* ===================== RELATIONSHIPS ===================== */

    Customer -> User [arrowhead=empty, label="extends"];
    Admin -> User [arrowhead=empty, label="extends"];

    CashOnDelivery -> PaymentMethod [arrowhead=empty, style=dashed, label="implements"];
    CreditCardPayment -> PaymentMethod [arrowhead=empty, style=dashed, label="implements"];
    WalletPayment -> PaymentMethod [arrowhead=empty, style=dashed, label="implements"];

    Customer -> Cart [arrowhead=diamond, dir=back, arrowtail=none, label="  1 owns 1\n(composition)"];
    Order -> OrderItem [arrowhead=diamond, dir=back, label="  1 owns *\n(composition)", constraint=false];

    Cart -> Product [arrowhead=vee, label="  * refs *\n(association)"];
    OrderItem -> Product [arrowhead=vee, label="  * refs 1"];
    FlashSale -> Product [arrowhead=vee, label="  * refs 1"];
    Order -> Customer [arrowhead=vee, label="  * placed by 1"];
    WalletPayment -> Customer [arrowhead=vee, style=dotted, label="  uses"];

    Order -> PaymentMethod [arrowhead=vee, style=dotted, label="  polymorphic\n  use"];

    FlashSale -> SaleStatus [arrowhead=vee, style=dotted];
    Order -> OrderStatus [arrowhead=vee, style=dotted];

    DataStore -> FileManager [arrowhead=odiamond, label="  has-a"];
    DataStore -> InventoryManager [arrowhead=odiamond, label="  has-a"];
    DataStore -> OrderProcessor [arrowhead=odiamond, label="  has-a"];
    DataStore -> FlashSaleScheduler [arrowhead=odiamond, label="  has-a"];
    DataStore -> Product [arrowhead=vee, style=dotted, label="  manages *"];
    DataStore -> Order [arrowhead=vee, style=dotted, label="  manages *"];
    DataStore -> User [arrowhead=vee, style=dotted, label="  manages *"];
    DataStore -> FlashSale [arrowhead=vee, style=dotted, label="  manages *"];

    InventoryManager -> Product [arrowhead=vee, style=dotted, label="  locks/updates"];
    InventoryManager -> FlashSale [arrowhead=vee, style=dotted, label="  locks/updates"];
    FlashSaleScheduler -> FlashSale [arrowhead=vee, style=dotted, label="  ticks *"];
    OrderProcessor -> Order [arrowhead=vee, style=dotted, label="  settles *"];

    /* layout hints */
    { rank=same; Customer; Admin; }
    { rank=same; CashOnDelivery; CreditCardPayment; WalletPayment; }
    { rank=same; InventoryManager; FlashSaleScheduler; OrderProcessor; FileManager; }
}
